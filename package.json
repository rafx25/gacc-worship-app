{
  "name": "gacc-worship",
  "productName": "GACC Worship",
  "version": "1.3.5",
  "description": "Offline worship presentation app for God's Anointing Christian Church",
  "author": "GACC",
  "private": true,
  "main": "main.js",
  "scripts": {
    "sync": "node scripts/sync-html.js",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder --win",
    "dist:mac": "npm run sync && electron-builder --mac",
    "dist:linux": "npm run sync && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.gacc.worship",
    "productName": "GACC Worship",
    "copyright": "God's Anointing Christian Church",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "GACC-Worship-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "GACC Worship",
      "artifactName": "GACC-Worship-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
